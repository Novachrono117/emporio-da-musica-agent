# Copy to .env and fill in. .env is gitignored; never commit a key.

# API keys (leave empty for providers you do not use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider and model the agent uses: anthropic | gemini | ollama
LLM_PROVIDER=
LLM_MODEL=

# Ollama OpenAI-compatible endpoint, e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# The agent's "today" (YYYY-MM-DD). Empty means the real current date.
EMPORIO_TODAY=

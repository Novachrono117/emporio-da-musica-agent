# Copy to .env and fill in. .env is gitignored; never commit a key.

# API keys (leave empty for providers you do not use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider and model the agent uses: anthropic | gemini | ollama
# Empty means gemini / gemini-3.5-flash-lite, the evaluation's default (docs/EVAL.md).
LLM_PROVIDER=
LLM_MODEL=

# Ollama OpenAI-compatible endpoint, e.g. http://localhost:11434/v1. The default local model, qwen3.5:4b, needs the
# Ollama server started with OLLAMA_CONTEXT_LENGTH=8192 (README); that variable belongs to Ollama, not to this file.
OLLAMA_BASE_URL=

# The agent's "today" in store time (UTC-4): YYYY-MM-DD keeps the real time of day, YYYY-MM-DDTHH:MM fixes both.
# Empty means 2026-03-23, the day after the last order (docs/DECISIONS.md, D-005).
EMPORIO_TODAY=
